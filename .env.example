# Copy this file to .env and fill in real values. Never commit .env.

SNAP_USERNAME=
SNAP_PASSWORD=

# Run the browser headless (true/false). Set to false when debugging locally
# or working through the initial 2FA/OTP login flow.
SNAP_HEADLESS=true

# Where Playwright's storage_state (session cookies/localStorage) is saved
# after login, so subsequent runs can skip re-authenticating.
SNAP_STORAGE_STATE_PATH=.auth/storage_state.json
