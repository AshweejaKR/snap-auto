# Copy this file to .env and fill in real values. Never commit .env.

SNAP_USERNAME=
SNAP_PASSWORD=

# Run the browser headless (true/false). Set to false when debugging locally
# or working through the initial 2FA/OTP login flow.
SNAP_HEADLESS=true

# Current Snapchat Web entry point. The client also tolerates redirects to the
# older web.snapchat.com host.
SNAP_BASE_URL=https://www.snapchat.com/web

# Where Playwright's storage_state (session cookies/localStorage) is saved
# after login, so subsequent runs can skip re-authenticating.
SNAP_STORAGE_STATE_PATH=.auth/storage_state.json

# Reliability controls. Retries apply only to idempotent browser operations;
# send_msg() never repeats a submitted message because that could create duplicates.
SNAP_DEFAULT_TIMEOUT_MS=15000
SNAP_NAVIGATION_TIMEOUT_MS=45000
SNAP_ACTION_RETRIES=3
SNAP_RETRY_BASE_DELAY_SECONDS=0.5
SNAP_ACTION_DELAY_MIN_SECONDS=0.15
SNAP_ACTION_DELAY_MAX_SECONDS=0.45
SNAP_RATE_LIMIT_COOLDOWN_SECONDS=60
SNAP_MAX_CHAT_SCROLLS=40

# On unexpected selector/UI failures, save a screenshot, page HTML, and sanitized
# metadata here. These files can contain private chat content; keep them local.
SNAP_CAPTURE_FAILURE_ARTIFACTS=true
SNAP_ARTIFACTS_PATH=.snap-auto-artifacts
